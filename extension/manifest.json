{
  "manifest_version": 3,
  "name": "Translation Magic Window：網頁漫畫",
  "version": "0.1.0",
  "description": "把網頁上整章漫畫圖片裡的文字翻成繁體中文，直接蓋在原圖上。需要電腦上的 Translation Magic Window。",
  "minimum_chrome_version": "125",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "網頁漫畫翻譯",
    "default_popup": "popup.html"
  },
  "key": ""
}
