{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-x64",
      "displayName": "MSVC x64",
      "description": "Visual Studio 2026 Build Tools，64 位元",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-x64-asan",
      "inherits": "msvc-x64",
      "displayName": "MSVC x64 + AddressSanitizer",
      "description": "開啟 AddressSanitizer，用來抓記憶體錯誤",
      "cacheVariables": {
        "TMW_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI（Ninja Multi-Config）",
      "description": "GitHub Actions 用：不綁 Visual Studio 版本，由 MSVC 開發者環境提供編譯器",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ci-asan",
      "inherits": "ci",
      "displayName": "CI + AddressSanitizer",
      "binaryDir": "${sourceDir}/build/ci-asan",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "TMW_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer",
      "configurePreset": "msvc-x64-asan",
      "configuration": "Debug"
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci",
      "configuration": "Debug"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci",
      "configuration": "Release"
    },
    {
      "name": "ci-asan",
      "configurePreset": "ci-asan",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "unit-only",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "integration"
        }
      }
    },
    {
      "name": "debug",
      "displayName": "Debug（單元測試）",
      "inherits": "unit-only",
      "configurePreset": "msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release（單元測試）",
      "inherits": "unit-only",
      "configurePreset": "msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer（單元測試）",
      "inherits": "unit-only",
      "configurePreset": "msvc-x64-asan",
      "configuration": "Debug"
    },
    {
      "name": "integration",
      "displayName": "整合測試（需要桌面，會短暫顯示測試視窗）",
      "configurePreset": "msvc-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "integration"
        }
      }
    },
    {
      "name": "ci-debug",
      "inherits": "unit-only",
      "configurePreset": "ci",
      "configuration": "Debug"
    },
    {
      "name": "ci-release",
      "inherits": "unit-only",
      "configurePreset": "ci",
      "configuration": "Release"
    },
    {
      "name": "ci-asan",
      "inherits": "unit-only",
      "configurePreset": "ci-asan",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "設定 → 建置 → 測試（Debug）",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-x64"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "release",
      "displayName": "設定 → 建置 → 測試（Release）",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-x64"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "asan",
      "displayName": "設定 → 建置 → 測試（AddressSanitizer）",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-x64-asan"
        },
        {
          "type": "build",
          "name": "asan"
        },
        {
          "type": "test",
          "name": "asan"
        }
      ]
    },
    {
      "name": "integration",
      "displayName": "設定 → 建置 → 整合測試",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-x64"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "integration"
        }
      ]
    }
  ]
}
