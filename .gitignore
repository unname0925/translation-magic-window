# 建置輸出
/build/
/out/

# 下載的第三方套件（ONNX Runtime 等），所有建置資料夾共用
/.cache/

# 模型：由 tools/fetch_models 下載，不放進倉庫
/models/

# 真實的測試截圖有版權，只放在本機
/testdata/private/

# VS Code：只保留專案共用的設定
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Visual Studio
.vs/
*.user

# CMake
CMakeUserPresets.json

# Python（評測腳本）
__pycache__/
*.pyc
.venv/
.venv-*/

# 當機傾印、系統檔
*.dmp
Thumbs.db
desktop.ini

# 建置或工具產生的記錄檔
*.log
